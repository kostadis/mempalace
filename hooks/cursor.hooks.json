{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/mempal_cursor_session_start.sh",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/mempal_cursor_stop.sh",
        "timeout": 30,
        "loop_limit": 1
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/mempal_cursor_precompact.sh",
        "timeout": 60
      }
    ]
  }
}
